          <mxGeometry height="126" width="456" x="112.5" y="532" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-8" parent="N8Y7AB-o-vH7Z575GZtp-7" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;existing application code&lt;/span&gt;&lt;br&gt;&lt;ul style=&quot;padding-left: 0px; margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;li&gt;NODE_ENV=development&lt;/li&gt;&lt;li&gt;PORT=3001&lt;/li&gt;&lt;li&gt;MONGODB_URI=mongodb://mongo:27017/back_in_stock_prototype&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="70" width="419" x="18.5" y="46" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-11" parent="1" style="swimlane;whiteSpace=wrap;html=1;swimlaneFillColor=default;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=38;" value="&lt;h2&gt;7. MongoDB container&lt;/h2&gt;" vertex="1">
          <mxGeometry height="100" width="456" x="112.5" y="728" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-20" parent="N8Y7AB-o-vH7Z575GZtp-11" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;It stores notification requests and inventory events, just as your local MongoDB does now.&lt;/font&gt;" vertex="1">
          <mxGeometry height="49" width="431" x="12.5" y="47" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-12" parent="1" style="swimlane;whiteSpace=wrap;html=1;swimlaneFillColor=default;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=31;" value="&lt;h2&gt;8. Named Docker volume&lt;/h2&gt;" vertex="1">
          <mxGeometry height="100" width="456" x="112.5" y="911" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-21" parent="N8Y7AB-o-vH7Z575GZtp-12" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Helvetica;fontColor=default;fontStyle=0;" value="&lt;font&gt;It keeps MongoDB data even if the MongoDB container is stopped or recreated.&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="424" x="16" y="39" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-34" edge="1" parent="1" source="N8Y7AB-o-vH7Z575GZtp-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="N8Y7AB-o-vH7Z575GZtp-12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N8Y7AB-o-vH7Z575GZtp-35" connectable="0" parent="N8Y7AB-o-vH7Z575GZtp-34" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;h3&gt;mount: mongodb_data:/data/db&lt;/h3&gt;" vertex="1">
          <mxGeometry relative="1" x="0.248" y="-2" as="geometry">
            <mxPoint x="5" y="-16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TBVx1pINAJsQbwLl_dNr-10" edge="1" parent="1" source="cI8IbBFspfZX6KJjQwv8-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="N8Y7AB-o-vH7Z575GZtp-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cI8IbBFspfZX6KJjQwv8-4" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=44;align=center;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;verticalAlign=middle;" value="&lt;h2 style=&quot;margin-top: 0px; margin-bottom: 0px;&quot;&gt;&lt;span style=&quot;color: rgb(52, 50, 45); white-space: pre-wrap;&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;&quot;&gt;5. Runtime configuration: &lt;/font&gt;&lt;/span&gt;&lt;/h2&gt;" vertex="1">
          <mxGeometry height="157" width="238" x="606" y="517" as="geometry" />
        </mxCell>
        <mxCell id="cI8IbBFspfZX6KJjQwv8-5" parent="cI8IbBFspfZX6KJjQwv8-4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=default;fontStyle=0;" value="&lt;span style=&quot;color: rgb(52, 50, 45); white-space: pre-wrap;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;compose.yaml provides NODE_ENV, PORT, and MONGODB_URI to the API container. The local .env file is used only for non-container execution and is not committed to Git.&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="218" x="11" y="50" as="geometry" />
        </mxCell>
        <mxCell id="TBVx1pINAJsQbwLl_dNr-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;h1&gt;Shopify Back-in-Stock Notification Prototype&lt;br&gt;Application Architecture Diagram (AAD)&lt;/h1&gt;" vertex="1">
          <mxGeometry height="67" width="1614" x="27" y="79" as="geometry" />
        </mxCell>
        <mxCell id="TBVx1pINAJsQbwLl_dNr-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1. Bruno or Browser&lt;/font&gt;&lt;/h2&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Bruno or a browser is outside the Docker environment. It sends HTTP requests, such as GET /health, POST /api/notifications, and POST /api/inventory-events, to the application.&lt;/font&gt;&lt;/p&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;2. Host Port Mapping (3001:3001)&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Docker maps port 3001 on the host computer to port 3001 in the API container. This allows Bruno or a browser to access the containerised API through http://localhost:3001.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;3. Docker Compose Environment&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Docker Compose creates and manages the API service, MongoDB service, private network, and persistent volume as one repeatable local development environment.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;4. Node.js / Express API Container&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;The API container runs the existing Node.js and Express application. It validates requests, creates notification requests, processes inventory events, and changes matching requests from pending to matched.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;5. Runtime Configuration&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;compose.yaml provides NODE_ENV, PORT, and MONGODB_URI to the API container. The local .env file is used only for non-container execution and is not committed to Git.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;6. Docker Compose Private Network&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;The API and MongoDB containers communicate through a private Docker network. The API connects to MongoDB using the internal service address mongo:27017. MongoDB is not exposed directly to the host computer.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;7. MongoDB Container&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;The MongoDB container stores notification requests and processed inventory events. Its health check allows Docker Compose to confirm that the database is ready before the API starts.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;8. Named Docker Volume&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;The mongodb_data volume stores MongoDB data outside the container. The data remains available if the MongoDB container is stopped or recreated. The volume is removed only when docker compose down --volumes is used.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Request Flow&lt;/u&gt;&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Bruno sends a request to localhost:3001. Docker forwards the request to the API container. The API validates and processes the request, communicates with MongoDB over the private network, and sends the response back to Bruno.&lt;br&gt;&lt;/font&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;u&gt;Security and Persistence&lt;/u&gt;&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Only API port 3001 is published to the host. MongoDB remains private to the Docker network. The API container runs as the non-root node user, local environment files are excluded from Git and Docker build context, and the named volume provides persistent database storage.&lt;/font&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="906" width="765" x="872" y="191" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
